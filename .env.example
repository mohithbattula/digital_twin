# =========================================================================
# Jaswanth Digital-Twin - Unified Environment Configuration Template
# Copy this file to .env before building: cp .env.example .env
# =========================================================================

# ── Backend Configurations (used by twin-backend container) ──────────────

# Supabase (Service Role is required to run vector matching and bypass RLS)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...your-service-role-key
SUPABASE_ANON_KEY=eyJ...your-anon-key

# OpenAI (used for embeddings generation and LangGraph nodes execution)
OPENAI_API_KEY=sk-proj-...

# LangSmith Tracing (highly recommended for agent trace observability)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=ls_...
LANGCHAIN_PROJECT=jaswanth-twin-prod

# Webhook Security Secret
WEBHOOK_SECRET=your-webhook-secret-string

# Server configurations (internal docker setup)
HOST=0.0.0.0
PORT=8740


# ── Frontend Configurations (injected into twin-frontend at build-time) ───

# Supabase Public Keys (safe to expose in client browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key

# Backend API Endpoint URL
# IMPORTANT: Since this Next.js app runs in the user's browser, this URL
# MUST be accessible from the client machine.
# - If running locally: http://localhost:8740/v1
# - If deploying on a remote VM (accessed via Putty/SSH): http://<YOUR_VM_IP_OR_DOMAIN>:8740/v1
NEXT_PUBLIC_API_URL=http://localhost:8740/v1

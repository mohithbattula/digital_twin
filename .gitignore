# =========================================================================
# Jaswanth Digital-Twin - Root .gitignore
# =========================================================================

# Environment variables & Secret files (EXCLUDING templates)
.env
.env.local
.env.development
.env.production
.env.test
.env.staging
.env.*
!.env.template
!.env.local.template
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
secrets/
credentials*.json

# Dependency directories
node_modules/
jspm_packages/
web_modules/
venv/
.venv/
env/
.env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Build & Output directories
.next/
out/
build/
dist/
target/
*.tsbuildinfo
next-env.d.ts

# Logs and databases
*.log
backend-dev.log
backend-dev.err.log
frontend-dev.log
frontend-dev.err.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.db
*.sqlite
*.sqlite3

# IDEs, Editors, and OS-generated files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.project
.classpath
.settings/
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# User uploads & Temporary files
backend/uploads/**/*
!backend/uploads/task-docs/
!backend/uploads/task-docs/.gitkeep
